# Copy to .env and fill in. Never commit .env.

# --- Generation: Azure OpenAI (GPT-4o) ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o
# Retries (rate limits, timeouts, 5xx) are done by the OpenAI SDK.
AZURE_OPENAI_MAX_RETRIES=3
AZURE_OPENAI_TIMEOUT_S=60

# --- Embeddings: OpenAI API (NOT Azure) ---
OPENAI_API_KEY=
# Changing either of these requires a full re-embed into a new collection.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Qdrant ---
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# --- Langfuse (self-hosted, infra/docker-compose.yml) ---
# Fill these with: uv run python -m scripts.init_langfuse_env --email you@example.com
# (generates the missing ones, never overwrites, never prints them).
# false: no tracing, prompts from git (prompts/*.yaml). Also off when the keys are blank.
LANGFUSE_ENABLED=true
LANGFUSE_ENVIRONMENT=development
# The prompt label the app serves (sync_prompts writes "staging"; promote_prompt moves this one).
LANGFUSE_PROMPT_LABEL=production
LANGFUSE_HOST=http://127.0.0.1:3000
# Project API keys: the SDK uses them, and headless setup creates them on the server.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Admin login for the web UI (signup is disabled).
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=
# Internal data-store passwords (compose network only, no host ports).
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_AUTH=
LANGFUSE_MINIO_PASSWORD=
# Signs login sessions.
LANGFUSE_NEXTAUTH_SECRET=
# Hashes API keys. Never change it once Langfuse has data.
LANGFUSE_SALT=
# 64 hex chars; encrypts secrets Langfuse stores. Never change it once Langfuse has data.
LANGFUSE_ENCRYPTION_KEY=

# --- Retrieval ---
# The reranker loads from the local Hugging Face cache only, at its pinned commit
# (RetrievalSettings.reranker_revisions): no Hub request at startup, works offline.
# Set false once to download a model or a newly pinned commit.
RETRIEVAL_RERANKER_LOCAL_ONLY=true

# --- Chat ---
# Recent messages used for query rewriting and answer context (loaded from SQLite).
CHAT_HISTORY_TURNS=6
CHAT_HISTORY_MAX_CHARS=1500
CHAT_MAX_MESSAGE_CHARS=2000

# --- API (FastAPI) ---
# Every endpoint but /health needs the header X-API-Key: <API_KEY>. The app refuses
# to start without it. Generate one: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# --- Chunking ---
# Chunks longer than this are split; 512 matches the reranker input window.
CHUNK_MAX_CHUNK_TOKENS=512
